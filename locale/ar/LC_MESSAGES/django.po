msgstr "هذا الشهر مصروف بالفعل (%(number)s)."

msgid "This month is closed: nothing can be posted into it and none of its documents can be cancelled."
msgstr "هذا الشهر مقفل: لا يمكن الترحيل فيه ولا إلغاء أي من مستنداته."

msgid "This month is not closed."
msgstr "هذا الشهر غير مقفل."

msgid "This month's payroll is already paid. Cancel it first, or choose the next month."
msgstr "مسير هذا الشهر مصروف بالفعل. ألغِه أولًا أو اختر الشهر التالي."

msgid "This needs the permission for all branches."
msgstr "يتطلب هذا الصلاحية على كل الفروع."

msgid "This number is not on WhatsApp."
msgstr "هذا الرقم ليس على واتساب."

msgid "This order has no receipt to cancel."
msgstr "لا يوجد استلام لهذا الأمر لإلغائه."

msgid "This order is no longer in production."
msgstr "هذا الأمر لم يعد قيد التصنيع."

msgid "This order is not at the workshop."
msgstr "هذا الأمر ليس لدى الورشة."

msgid "This page"
msgstr "هذه الصفحة"

msgid "This parcel is stopped."
msgstr "هذه البرتيتة موقوفة."

msgid "This period"
msgstr "هذه الفترة"

msgid "This piece belongs to another branch."
msgstr "هذه القطعة تابعة لفرع آخر."

msgid "This piece is not in stock."
msgstr "هذه القطعة ليست في المخزون."

msgid "This piece is not part of this stocktake."
msgstr "هذه القطعة ليست ضمن هذا الجرد."

