# Copy to .env and fill in. .env is git-ignored. URL-encode special characters in passwords.
# Every variable the settings read is listed here; commented ones show their default.
# DJANGO_SETTINGS_MODULE works here only for processes started with this file as their
# environment (systemd EnvironmentFile=): the settings read .env after the module is chosen.
# Unset, manage.py uses config.settings.dev and gunicorn (config/wsgi.py) config.settings.prod.
# On a server, also export it in the shell of whoever runs manage.py (migrate, backup), or
# those commands run with development settings.
# DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Hosts Django answers (production: .your-domain.com). Default: .localhost
# DJANGO_ALLOWED_HOSTS=.localhost,localhost,127.0.0.1
# New clients get <slug>.<TENANT_BASE_DOMAIN> (custom domains are added in the console).
# TENANT_BASE_DOMAIN=localhost
# LOG_LEVEL=INFO

# Runtime role: subject to row-level security.
DATABASE_URL=postgres://app_rw:CHANGE_ME@localhost:5432/gweb
# Owner role: runs migrations (`manage.py migrate --database owner`) and the test suite.
DATABASE_OWNER_URL=postgres://app_owner:CHANGE_ME@localhost:5432/gweb
# Tests only: another database URL for the owner role (default: DATABASE_OWNER_URL). Never a
# superuser: superusers bypass row-level security and the isolation tests would prove nothing.
# TEST_DATABASE_URL=
# Seconds a database connection is kept open (0: one per request).
# DB_CONN_MAX_AGE=0

PLATFORM_HOSTS=admin.localhost

# PII encryption (required in production). Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Client traffic: default requests per minute per client (0 = no limit; each client can be
# changed in the platform console), and how slow a request must be to count as slow.
TENANT_REQUESTS_PER_MINUTE=600
TRAFFIC_SLOW_MS=1000

# E-mail for documents sent to customers and the daily reminders (development writes them to
# var/mail when EMAIL_URL is empty). Example: smtp+tls://user:password@smtp.example.com:587
EMAIL_URL=
DEFAULT_FROM_EMAIL=no-reply@example.com
# Links in e-mails: https://<client's domain><SITE_PORT>
SITE_SCHEME=https
SITE_PORT=

# Server errors (Console → Errors) are e-mailed to these addresses when a new one appears.
ERROR_ALERT_EMAILS=

# Backups (manage.py backup, nightly through the worker; Console → Backups). The dump needs the
# role that bypasses row-level security; pg_dump must be installed (or give its full path).
BACKUP_DATABASE_URL=postgres://app_platform:CHANGE_ME@localhost:5432/gweb
BACKUP_DIR=
BACKUP_KEEP=14
BACKUP_PG_DUMP=pg_dump
# Every new dump is read back with it; `manage.py verify_backup` uses it to test a restore.
BACKUP_PG_RESTORE=pg_restore

# Production cache shared by every process (default: a file cache under var/cache). Several
# servers: rediscache://… (redis package) or dbcache://gweb_cache (createcachetable).
CACHE_URL=

# Uploads (one folder per client). Served only through the application, never by nginx.
# MEDIA_ROOT=var/media

# Server monitoring (manage.py monitor_server; Console → Server). Thresholds in %.
# MONITOR_SAMPLE_SECONDS=10
# MONITOR_RETENTION_DAYS=7
# MONITOR_WARN_PCT=75
# MONITOR_CRITICAL_PCT=90

# Background jobs (manage.py run_worker): idle wait between polls, and how often market gold
# prices are read.
# JOBS_POLL_SECONDS=2
# MARKET_POLL_MINUTES=3

# One-time codes to customers' phones, tried in this order (development and tests: console).
# CODE_CHANNELS=whatsapp,sms
# Gweb's WhatsApp gateway for those codes.
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_KEY=
# WHATSAPP_GATEWAY_ENDPOINT=/whatsapp/send-otp/
# A shop's own WhatsApp number: ops/wa-gateway (Node), one session per client. Same key as
# the gateway's own WA_GATEWAY_KEY.
WA_GATEWAY_URL=
WA_GATEWAY_KEY=
# true: WhatsApp messages are written to the log instead of sent (development).
# WHATSAPP_CONSOLE=false
# Any SMS provider taking mobile/message/sender.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=

# Gem lab reports (Diamonds feature): the public PDF and the report data (optional key).
# IGI_PDF_URL=https://pdf.igi.org/{name}.pdf
# IGI_API_URL=https://api.igi.org/ReportDetail.php
IGI_API_KEY=

# Production only (config/settings/prod.py): the header our reverse proxy puts the visitor's
# address in (sign-in history), and HSTS max-age in seconds (default 30 days).
# SIGNIN_IP_HEADER=HTTP_X_FORWARDED_FOR
# SECURE_HSTS_SECONDS=2592000
