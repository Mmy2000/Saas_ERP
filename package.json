{
  "name": "gweb-platform-assets",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i ./assets/css/app.css -o ./static/core/css/app.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/app.css -o ./static/core/css/app.css --watch",
    "assets": "node ./assets/copy-assets.mjs",
    "build": "npm run assets && npm run build:css"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "lucide-static": "^1.48.0",
    "tailwindcss": "^4.3.3",
    "tom-select": "^2.6.2"
  }
}
