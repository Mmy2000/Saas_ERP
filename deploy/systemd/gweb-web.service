# The web app: gunicorn on 127.0.0.1:8000 behind nginx. `systemctl reload gweb-web` restarts
# its workers on new code without dropping requests (deploy/release.sh does).
[Unit]
Description=Gweb web (gunicorn)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/.env
# Chromium (PDFs) writes under $HOME: a writable one inside the app folder.
Environment=HOME=@APP_DIR@/var/home
ExecStart=@APP_DIR@/venv/bin/gunicorn config.wsgi --bind 127.0.0.1:8000 \
    --workers @WORKERS@ --timeout 120 --graceful-timeout 30 \
    --access-logfile - --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=35
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
