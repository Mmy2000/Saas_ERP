# Server samples for Console → Server (CPU, memory, disk, network, PostgreSQL).
[Unit]
Description=Gweb server monitor
After=network.target postgresql.service
Requires=postgresql.service

[Service]
User=@APP_USER@
Group=@APP_USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=@APP_DIR@/.env
# Chromium (PDFs) writes under $HOME: a writable one inside the app folder.
Environment=HOME=@APP_DIR@/var/home
ExecStart=@APP_DIR@/venv/bin/python manage.py monitor_server
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
