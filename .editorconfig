# Editor defaults matching the codebase (docs/standards/coding.md). UTF-8 without a byte order
# mark is enforced by tests/test_repo_hygiene.py.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 100

[*.{po,sql}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
